# systemd user unit. Install in ~/.config/systemd/user/, adjust ExecStart to
# where the binary is, then: systemctl --user enable --now gamepad-desktop
[Unit]
Description=Gamepad to keyboard and mouse mapper
Documentation=https://github.com/LeVraiBaptiste/gamepad-desktop
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/gamepad-desktop
Restart=on-failure
RestartSec=3
MemoryMax=64M
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
